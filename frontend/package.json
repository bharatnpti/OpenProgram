{
  "name": "pulseops-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:client": "openapi-typescript src/api/openapi.json -o src/api/generated.ts && prettier --write src/api/generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.7.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "openapi-typescript": "^7.0.0",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16"
  }
}
