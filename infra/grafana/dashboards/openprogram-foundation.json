{
  "title": "PulseOps Foundation",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "API Availability",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "pulseops_info",
          "legendFormat": "backend up"
        },
        {
          "expr": "up{job=\"otel-collector\"}",
          "legendFormat": "otel collector"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Request Rate",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (route, status_code) (rate(pulseops_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Latency P95",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(pulseops_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
