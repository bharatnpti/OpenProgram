OPENPROGRAM_ENVIRONMENT=local
OPENPROGRAM_TENANT_ID=demo
OPENPROGRAM_RUNTIME_MODE=container
OPENPROGRAM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
OPENPROGRAM_DATABASE_URL=postgresql://openprogram:openprogram@localhost:5432/openprogram
OPENPROGRAM_POSTGRES_POOL_MIN_SIZE=1
OPENPROGRAM_POSTGRES_POOL_MAX_SIZE=5
OPENPROGRAM_REDIS_URL=redis://localhost:6379/0
OPENPROGRAM_REDIS_MAX_CONNECTIONS=10
OPENPROGRAM_WORKFLOW_PROVIDER=dbos
OPENPROGRAM_DBOS_APP_NAME=openprogram
OPENPROGRAM_DBOS_SYSTEM_DATABASE_URL=
OPENPROGRAM_DBOS_HEARTBEAT_CRON="0 * * * * *"
OPENPROGRAM_HEARTBEAT_SCHEDULE_ID=openprogram-heartbeat
OPENPROGRAM_CHECKIN_FANOUT_CRON="30 9 * * 1-5"
OPENPROGRAM_CHECKIN_RECONCILE_ENABLED=true
OPENPROGRAM_CHECKIN_RECONCILE_SCHEDULE_ID=openprogram-checkin-reconcile
OPENPROGRAM_CHECKIN_RECONCILE_CRON="*/15 * * * 1-5"
OPENPROGRAM_CHECKIN_RECONCILE_AFTER_LOCAL_TIME="09:45"
OPENPROGRAM_CHECKIN_RECONCILE_TIMEZONE=
OPENPROGRAM_CONVERSATION_RETENTION_DAYS=30
OPENPROGRAM_CONVERSATION_PURGE_ENABLED=true
OPENPROGRAM_CONVERSATION_PURGE_CRON="0 3 * * *"
OPENPROGRAM_CONVERSATION_PURGE_SCHEDULE_ID=openprogram-conversation-purge
OPENPROGRAM_CHAT_PROVIDER=slack
OPENPROGRAM_DIRECTORY_PROVIDER=slack
OPENPROGRAM_DIRECTORY_SYNC_CRON="0 */6 * * *"
OPENPROGRAM_DIRECTORY_SYNC_SCHEDULE_ID=openprogram-directory-sync
# DM the person a check-in reply asks something of ("need Liam to review the PR"):
# who asked, the kind and a short note -- never the reply itself. On by default;
# set to false to record the request without messaging anyone.
OPENPROGRAM_CROSS_PERSON_AUTO_NOTIFY=true
# A counterpart DM that failed to send is retried every few minutes by the
# worker: MAX_ATTEMPTS sends in all (the first included), waiting BACKOFF seconds
# after the first failure and twice as long after each later one. After that the
# request shows as "not delivered" to its requester. Needs AUTO_NOTIFY on.
OPENPROGRAM_CROSS_PERSON_NOTIFY_RETRY_ENABLED=true
OPENPROGRAM_CROSS_PERSON_NOTIFY_RETRY_SCHEDULE_ID=openprogram-cross-person-notify-retry
OPENPROGRAM_CROSS_PERSON_NOTIFY_RETRY_CRON="*/5 * * * *"
OPENPROGRAM_CROSS_PERSON_NOTIFY_MAX_ATTEMPTS=5
OPENPROGRAM_CROSS_PERSON_NOTIFY_RETRY_BACKOFF_SECONDS=300
OPENPROGRAM_ISSUE_TRACKER_PROVIDER=jira
OPENPROGRAM_VCS_PROVIDER=gitlab
OPENPROGRAM_CALENDAR_PROVIDER=google
OPENPROGRAM_TEMPORAL_TARGET=localhost:7233
OPENPROGRAM_TEMPORAL_TASK_QUEUE=openprogram-foundation
OPENPROGRAM_LITELLM_BASE_URL=http://localhost:4000
OPENPROGRAM_LITELLM_API_KEY=local-litellm-key
OPENPROGRAM_LITELLM_MODEL=gpt-5.5
OPENPROGRAM_LLM_PROVIDER=litellm
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENPROGRAM_EMBEDDING_DIMENSION=1536
OPENPROGRAM_LANGFUSE_HOST=http://localhost:3001
OPENPROGRAM_LANGFUSE_PUBLIC_KEY=pk-lf-local
OPENPROGRAM_LANGFUSE_SECRET_KEY=sk-lf-local
OPENPROGRAM_LANGFUSE_PROJECT_ID=local-project
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
OPENPROGRAM_SLACK_BOT_TOKEN=
# How Slack delivers replies. http (default): Slack POSTs to
# https://<api-host>/webhooks/chat/slack -- needs a public HTTPS endpoint and
# SLACK_SIGNING_SECRET. socket: the worker holds an outbound Socket Mode
# WebSocket -- set SLACK_APP_TOKEN (xapp-, scope connections:write), no public
# URL needed; suits local development and UAT.
OPENPROGRAM_SLACK_INBOUND_TRANSPORT=http
OPENPROGRAM_SLACK_APP_TOKEN=
OPENPROGRAM_SLACK_SIGNING_SECRET=
OPENPROGRAM_SLACK_API_BASE_URL=https://slack.com/api
OPENPROGRAM_JIRA_BASE_URL=
OPENPROGRAM_JIRA_EMAIL=
OPENPROGRAM_JIRA_API_TOKEN=
OPENPROGRAM_JIRA_SYNC_PROJECTS=
OPENPROGRAM_GITHUB_BASE_URL=https://api.github.com
OPENPROGRAM_GITHUB_TOKEN=
OPENPROGRAM_GITHUB_OWNER=
OPENPROGRAM_GITLAB_BASE_URL=https://gitlab.com/api/v4
OPENPROGRAM_GITLAB_TOKEN=
OPENPROGRAM_GITLAB_NAMESPACE_ID=
OPENPROGRAM_SECRET_KEY=q6boIR1bNUZ-gozCYInhKglccJM7x11ysXmhquzIoUQ=
OPENPROGRAM_DEV_PRINCIPAL_SUBJECT=dev-user
OPENPROGRAM_DEV_PRINCIPAL_ROLES=admin
# The console's public address, for links in what OpenProgram sends out (the
# day report's "Open in OpenProgram", the report's own page). Empty uses OPENPROGRAM_AUTH_FRONTEND_URL
# (default http://localhost:5173). Unless OPENPROGRAM_ENVIRONMENT=local, a local
# address (localhost, 127.0.0.1, [::1], *.localhost) is never linked: the report
# goes out without the link. Set it in every deployed environment.
OPENPROGRAM_CONSOLE_URL=

# Provider selectors are independent. Local mock/fake overrides:
# OPENPROGRAM_CHAT_PROVIDER=mock_slack
# OPENPROGRAM_DIRECTORY_PROVIDER=mock_slack
# OPENPROGRAM_ISSUE_TRACKER_PROVIDER=fake
# OPENPROGRAM_VCS_PROVIDER=fake
# OPENPROGRAM_CALENDAR_PROVIDER=fake
# OPENPROGRAM_LLM_PROVIDER=fake

# LiteLLM routed through the local mock LLM instead of the real provider:
# OPENPROGRAM_LLM_PROVIDER=litellm
# OPENPROGRAM_LITELLM_MODEL=local-gpt
# OPENPROGRAM_CHAT_SIMULATOR_ENABLED=true
# Local demo: lets the console act as any seeded person without logging in.
# Default false; refused unless environment=local and auth_provider=dev.
OPENPROGRAM_DEMO_MODE=false
