{
  "name": "openprogram-frontend-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "VITE_API_BASE_URL= vite build && node scripts/mock-api.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:client": "openapi-typescript src/api/openapi.json -o src/api/generated.ts && prettier --write src/api/generated.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.50.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.7.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.1.0"
  }
}
